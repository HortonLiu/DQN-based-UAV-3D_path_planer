
<simulator>
    <env>
        <Env_Type>PathPlan_City</Env_Type> 
        <!-- initially the map is 500x500 -->
        <!-- if change this we need to update the UI.xml either -->
        <len>500</len>
        <width>500</width>
        <h>100</h>
        <eps>0.1</eps>
        <Is_AC>0</Is_AC>
        <Is_FL>0</Is_FL>
        <Is_On_Policy>0</Is_On_Policy>
        <FL_Loop>3</FL_Loop>
        <print_loop>2</print_loop>
        <!-- if u dont want single UAV, change this -->
        <num_UAV>1</num_UAV>
        <!-- Six of the existing 26 cylinders move; all speeds are m/s. -->
        <Dynamic_Obstacles>
            <enabled>1</enabled>
            <speed>4.0</speed>
            <!-- Default reciprocal endpoints: intersections with the 0..500 map.
                 Optional half_range (meters) limits travel around each initial center. -->
        </Dynamic_Obstacles>
        <Agent>
            <xml_path_agent>./config/UAV.xml</xml_path_agent>
            <Trainer>
                <Trainer_path>./config/Trainer.xml</Trainer_path>
            </Trainer>
        </Agent>
        <Obstacles>
            <buildings>./config/buildings.xml</buildings>
        </Obstacles>
        <UI>
            <UI_path>./config/UI.xml</UI_path>
        </UI>
        <DB>
            <DB_path>./config/DB.xml</DB_path>
        </DB>
    </env>
    <!-- 10 -->
    <record_epo>10</record_epo>
    <!-- 1000 -->
    <num_episodes>1000</num_episodes> 
    <max_eps_episode>1</max_eps_episode>
    <min_eps>0.1</min_eps>
    <TARGET_UPDATE>3</TARGET_UPDATE>
</simulator>