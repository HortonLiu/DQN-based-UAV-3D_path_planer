<Trainer>
    <Trainer_Type>PG_ITD3_Trainer</Trainer_Type>
    <Is_Train>1</Is_Train>
    <IsPriority_Replay>1</IsPriority_Replay>
    <actor>
        <NetWork>PolicyNet_TD3</NetWork>
        <h>1</h>
        <w>63</w>
        <channel>1</channel>
        <action_bound>1</action_bound>
        <hiden_dim>256</hiden_dim>
        <output>20</output>
        <lr>0.0001</lr>
    </actor>
    <critic>
        <NetWork>QValueNet_TD3</NetWork>
        <h>1</h>
        <w>63</w>
        <channel>1</channel>
        <hiden_dim>256</hiden_dim>
        <output>20</output>
        <lr>0.001</lr>
    </critic>
    <TD3_param>
        <gamma>0.99</gamma>
        <tau>0.005</tau>
        <policy_noise>0.2</policy_noise>
        <noise_clip>0.5</noise_clip>
        <policy_delay>2</policy_delay>
        <exploration_noise>0.2</exploration_noise>
        <exploration_noise_min>0.02</exploration_noise_min>
        <state_scale>500.0</state_scale>
        <repulsion_range>160.0</repulsion_range>
        <risk_weight>1.0</risk_weight>
        <aftershock_k>0.2</aftershock_k>
        <aftershock_c>0.1</aftershock_c>
        <aftershock_p>1.1</aftershock_p>
        <aftershock_delta_t>1.0</aftershock_delta_t>
        <priority_alpha>0.6</priority_alpha>
        <priority_beta>0.4</priority_beta>
        <priority_beta_increment>0.001</priority_beta_increment>
    </TD3_param>
    <Priority_Replay>1</Priority_Replay>
    <replay_size>10000</replay_size>
    <LEARNING_RATE>0.0005</LEARNING_RATE>
    <Batch_Size>256</Batch_Size>
    <max_epoch>100</max_epoch>
    <save_loop>100</save_loop>
</Trainer>
