<Trainer>
    <Trainer_Type>DDPG_Trainer</Trainer_Type>
    <Is_Train>1</Is_Train>
    <h>1</h>
    <w>9</w>
    <channel>1</channel>
    <output>2</output>
    <actor>
        <NetWork>PolicyNet_DDPG</NetWork>
        <h>1</h>
        <w>9</w>
        <channel>1</channel>
        <hiden_dim>256</hiden_dim>
        <output>2</output>
        <action_bound>1.0</action_bound>
        <lr>0.0001</lr>
    </actor>
    <critic>
        <NetWork>QValueNet_DDPG</NetWork>
        <h>1</h>
        <w>9</w>
        <channel>1</channel>
        <hiden_dim>256</hiden_dim>
        <output>2</output>
        <lr>0.001</lr>
    </critic>
    <action_bound>1.0</action_bound>
    <gamma>0.99</gamma>
    <tau>0.005</tau>
    <Update_loop>1</Update_loop>
    <exploration_noise>0.2</exploration_noise>
    <exploration_noise_min>0.02</exploration_noise_min>
    <Load_Model>0</Load_Model>
    <Priority_Replay>0</Priority_Replay>
    <replay_size>10000</replay_size>
    <LEARNING_RATE>0.0005</LEARNING_RATE>
    <Batch_Size>128</Batch_Size>
    <max_epoch>100</max_epoch>
    <save_loop>100</save_loop>
</Trainer>
